#!/bin/bash

# Backend for the OmaDBngin bar widget (blackcode.omadbngin).
#
# A DBngin-style manager for local database servers, in two modes:
#
#   native  The engine itself, like DBngin. Official builds of each version are
#           downloaded once into ~/.local/share/omadbngin/engines/<engine>/<version>,
#           every server gets its own data directory under
#           ~/.local/share/omadbngin/servers/<name>, and runs as the systemd user
#           service omadbngin-<name>.service. No root, no system packages.
#   docker  A container named omadbngin-<name>, labelled omadbngin.managed=1, with its
#           data in the named volume omadbngin-<name>.
#
# Both listen on 127.0.0.1 only. Servers this plugin did not create are never touched.
#
#   dbctl state [--full]            JSON: docker status, engines, servers (--full adds CPU time,
#                                   memory and a readiness check per running server)
#   dbctl sizes                     JSON: data size on disk per server (cached 5 min)
#   dbctl create <engine> <version> <name> <port> <autostart:on|off> [native|docker] [user] [password]
#                                   (the password is better given in OMADBNGIN_PASSWORD)
#   dbctl start|stop|restart <name>
#   dbctl remove <name> [--keep-data]
#   dbctl autostart <name> on|off
#   dbctl url <name>                print the connection URL
#   dbctl copy <name> [format]      copy the connection to the clipboard
#   dbctl conn <name> [format]      print it; formats: url env laravel django jdbc cli
#   dbctl client <name>             open the engine's CLI client in a terminal
#   dbctl logs <name>               follow the server log in a terminal
#   dbctl port <engine> [from]      next free port for an engine (from the default or <from>)
#   dbctl tail <name>               print the last 200 log lines and follow (for the panel)
#   dbctl stack list                JSON: stacks and their servers
#   dbctl stack add <stack> <name>  put a server in a stack (a server is in one stack at most)
#   dbctl stack remove <name>       take a server out of its stack
#   dbctl stack delete <stack>      delete a stack (its servers stay)
#   dbctl stack start|stop <stack>  start or stop every server of a stack
#   dbctl bind | unbind             add or remove SUPER+ALT+D (open the panel) in
#                                   ~/.config/hypr/bindings.lua
#   dbctl setup                     first run only (the widget runs it): add SUPER+ALT+D if free
#   dbctl install <engine> <version>  download a native engine without creating a server
#   dbctl backup <name> [file]      dump every database (Redis/Valkey: an RDB) to the backup
#                                   folder (OMADBNGIN_BACKUP_DIR, default ~/Downloads)
#   dbctl restore <name> <file>     load a dump or an RDB snapshot into the server
#   dbctl backups <name>            JSON: this server's backups in the backup folder, newest first
#   dbctl set-port <name> <port>    move a server to another port
#
# Native downloads are pinned and checksummed in engines.lock, and Docker images are pinned
# there by digest (see tools/update-engines-lock).

set -euo pipefail

PREFIX="omadbngin-"
LABEL="omadbngin.managed=1"
HOME_DIR="${OMADBNGIN_HOME:-$HOME/.local/share/omadbngin}"
ENGINES_DIR="$HOME_DIR/engines"
SERVERS_DIR="$HOME_DIR/servers"
UNIT_DIR="$HOME/.config/systemd/user"
STACKS="$HOME_DIR/stacks.json"
BACKUP_DIR="${OMADBNGIN_BACKUP_DIR:-$HOME/Downloads}"

fail() {
  echo "dbctl: $*" >&2
  exit 1
}

# engine|title|default port|version lines (first is the default)[|docker: Docker only]
ENGINES=(
  "postgresql|PostgreSQL|5432|18 17 16 15 14"
  "postgis|PostGIS|5432|18-3.6 17-3.6 16-3.6 15-3.6 14-3.6|docker"
  "mysql|MySQL|3306|9.7 8.4 8.0"
  "mariadb|MariaDB|3306|11.8 11.4 10.11"
  "redis|Redis|6379|8 7"
  "valkey|Valkey|6379|9 8"
  "mongodb|MongoDB|27017|8 7"
)

engine_field() {
  local e
  for e in "${ENGINES[@]}"; do
    IFS='|' read -r id title port versions only <<<"$e"
    if [[ $id == "$1" ]]; then
      case $2 in
      title) echo "$title" ;;
      port) echo "$port" ;;
      versions) echo "$versions" ;;
      only) echo "$only" ;;
      esac
      return 0
    fi
  done
  fail "unknown engine: $1"
}

# PostGIS is PostgreSQL with the PostGIS extension (the postgis/postgis images): clients,
# URLs, backups and restores are PostgreSQL's.
kind_of() { if [[ $1 == postgis ]]; then echo postgresql; else echo "$1"; fi; }

container() { echo "$PREFIX$1"; }
unit() { echo "$PREFIX$1.service"; }
server_dir() { echo "$SERVERS_DIR/$1"; }

# docker | native | "" for a name nobody owns
mode_of() {
  if [[ -f $(server_dir "$1")/server.json ]]; then
    echo native
  elif command -v docker >/dev/null &&
    [[ $(docker inspect -f '{{index .Config.Labels "omadbngin.managed"}}' "$(container "$1")" 2>/dev/null) == 1 ]]; then
    echo docker
  fi
}

require_managed() {
  [[ -n ${1:-} ]] || fail "missing server name"
  # The same rule create uses, so a name can never point outside the servers folder.
  [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] || fail "no server named $1"
  MODE=$(mode_of "$1")
  [[ -n $MODE ]] || fail "no server named $1"
}

# field of a server, either mode
field_of() {
  if [[ $MODE == native ]]; then
    jq -r ".$2" "$(server_dir "$1")/server.json"
  else
    docker inspect -f "{{index .Config.Labels \"omadbngin.$2\"}}" "$(container "$1")"
  fi
}

port_taken() {
  local p=$1
  ss -ltnH "sport = :$p" 2>/dev/null | grep -q . && return 0
  # Stopped servers still own their port.
  if compgen -G "$SERVERS_DIR/*/server.json" >/dev/null; then
    jq -e --argjson p "$p" 'select(.port == $p)' "$SERVERS_DIR"/*/server.json >/dev/null 2>&1 && return 0
  fi
  if [[ $(docker_status) == running ]]; then
    docker ps -a --filter "label=$LABEL" --filter "label=omadbngin.port=$p" -q | grep -q . && return 0
  fi
  return 1
}

next_port() {
  local p
  p=$(engine_field "$1" port)
  [[ ${2:-} =~ ^[0-9]{2,5}$ ]] && (($2 >= 1024 && $2 <= 65535)) && p=$2
  while port_taken "$p"; do p=$((p + 1)); done
  echo "$p"
}

# ---- Credentials -------------------------------------------------------------

default_user() {
  case $1 in
  postgresql | postgis) echo postgres ;;
  mysql | mariadb) echo root ;;
  redis | valkey) echo default ;;
  mongodb) echo "" ;;
  esac
}

# Passwords never go on a command line, where every local account can read them (ps,
# /proc/<pid>/cmdline): they travel in the environment, on stdin or in private files.
uri() { printf '%s' "$1" | jq -sRr @uri; }

# A private scratch directory (mode 700) on a short path, so sockets fit in it too.
private_tmp() { mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/omadbngin.XXXXXX"; }

# Single quotes can never reach SQL: passwords are checked in cmd_create.
mysql_setup_sql() {
  local user=$1 pass=$2 ident="" h
  [[ -n $pass ]] && ident=" IDENTIFIED BY '$pass'"
  echo "DROP USER IF EXISTS ''@'localhost'; DROP USER IF EXISTS ''@'%';"
  if [[ $user != root ]]; then
    for h in % localhost; do
      echo "CREATE USER '$user'@'$h'$ident; GRANT ALL PRIVILEGES ON *.* TO '$user'@'$h' WITH GRANT OPTION;"
    done
  fi
  # root shares the password, so the server is never left open behind your back.
  if [[ -n $pass ]]; then
    for h in localhost % 127.0.0.1 ::1; do echo "ALTER USER IF EXISTS 'root'@'$h'$ident;"; done
  fi
  echo "FLUSH PRIVILEGES;"
}

# Run SQL as passwordless root once the server takes TCP connections: "$@" is the client.
mysql_apply() {
  local sql=$1 i
  shift
  for i in $(seq 1 120); do
    "$@" -e "SELECT 1" >/dev/null 2>&1 && break
    sleep 1
  done
  local out
  out=$("$@" <<<"$sql" 2>&1) || fail "setting the user and password failed: $(tail -1 <<<"$out")"
}

# The auth part of a Redis/Valkey config file (native: the server's .conf; Docker: a file in
# the volume), never command-line flags.
redis_auth_conf() {
  local user=$1 pass=$2
  if [[ $user == default ]]; then
    [[ -n $pass ]] && printf 'requirepass "%s"\n' "$pass"
  else
    local secret=nopass
    [[ -n $pass ]] && secret=">$pass"
    printf 'user default off\nuser %s on %s ~* &* +@all\n' "$user" "$secret"
  fi
  return 0
}

docker_status() {
  [[ -n ${DOCKER_STATUS_:-} ]] && { echo "$DOCKER_STATUS_"; return; }
  DOCKER_STATUS_=$(docker_status_check)
  echo "$DOCKER_STATUS_"
}

docker_status_check() {
  command -v docker >/dev/null || { echo missing; return; }
  # `docker info` takes ~60 ms and the panel asks often: the system daemon with a socket we
  # may use is a few ms to check. Anything else (rootless, another context) gets the full check.
  local sock=${DOCKER_HOST:-unix:///var/run/docker.sock}
  sock=${sock#unix://}
  if [[ -S $sock && -w $sock ]] &&
    { systemctl is-active --quiet docker.service || systemctl is-active --quiet docker.socket; }; then
    echo running
    return
  fi
  docker info >/dev/null 2>&1 || { echo stopped; return; }
  echo running
}

# ---- Native engines: pinned, verified, installed once ------------------------
#
# engines.lock (next to this script) pins the exact build, URL and SHA-256 of
# every engine line, so a download is bound to the reviewed plugin commit.
# Nothing unpinned is ever downloaded, and nothing is unpacked, built or run
# before its checksum matches. Regenerate with tools/update-engines-lock.

LOCK="$(dirname "$(readlink -f "$0")")/engines.lock"

# JSON {version, sha256, urls} for engines.<engine>.<line>, or extras.<name>
pinned() {
  [[ -f $LOCK ]] || fail "engines.lock is missing; reinstall the plugin"
  local j
  if [[ $1 == extras ]]; then
    j=$(jq -c --arg n "$2" '.extras[$n] // empty' "$LOCK")
  else
    j=$(jq -c --arg e "$1" --arg l "$2" '.engines[$e][$l] // empty' "$LOCK")
  fi
  [[ -n $j ]] || fail "no pinned build for $1 $2 in engines.lock"
  echo "$j"
}

# fetch_verified <pinned json> <out>: try each URL, keep the file only if its SHA-256 matches.
fetch_verified() {
  local pin=$1 out=$2 sha url got
  sha=$(jq -r .sha256 <<<"$pin")
  [[ $sha =~ ^[0-9a-f]{64}$ ]] || fail "engines.lock has no valid checksum for ${out##*/}"
  while IFS= read -r url; do
    curl -fL --proto =https --connect-timeout 15 --retry 3 -o "$out" "$url" 2>/dev/null || continue
    got=$(sha256sum "$out" | cut -d' ' -f1)
    [[ $got == "$sha" ]] && return 0
    rm -f "$out"
    fail "checksum mismatch for $url (expected $sha, got $got); nothing was installed"
  done < <(jq -r '.urls[]' <<<"$pin")
  rm -f "$out"
  fail "download failed: $(jq -r '.urls[0]' <<<"$pin")"
}

# Download (or build) the pinned build of an engine line once; prints the install directory.
ensure_engine() {
  local engine=$1 line=$2 pin v
  pin=$(pinned "$engine" "$line")
  v=$(jq -r .version <<<"$pin")
  local dest="$ENGINES_DIR/$engine/$v"
  if [[ -d $dest ]]; then
    add_compat "$dest"
    echo "$dest"
    return
  fi

  mkdir -p "$ENGINES_DIR/$engine" "$HOME_DIR/tmp"
  exec 9>"$HOME_DIR/tmp/$engine-$line.lock"
  flock 9
  if [[ -d $dest ]]; then echo "$dest"; return; fi

  local url work="$dest.tmp"
  url=$(jq -r '.urls[0]' <<<"$pin")
  local archive="$HOME_DIR/tmp/${url##*/}"
  echo "Downloading $(engine_field "$engine" title) $v…" >&2
  fetch_verified "$pin" "$archive"
  rm -rf "$work"
  mkdir -p "$work"

  if [[ $engine == redis ]]; then
    # Redis publishes no Linux binaries: build the verified source release (a minute or so).
    local src="$HOME_DIR/tmp/$engine-$v-src"
    rm -rf "$src"
    mkdir -p "$src"
    tar -xzf "$archive" -C "$src" --strip-components=1
    echo "Building $(engine_field "$engine" title) $v…" >&2
    # Only the server and CLI: Redis 8's full build also wants cmake for optional modules.
    make -C "$src/src" -j"$(nproc)" BUILD_TLS=no MALLOC=libc "$engine-server" "$engine-cli" >/dev/null 2>&1 ||
      fail "building $engine $v failed"
    mkdir -p "$work/bin"
    cp "$src"/src/"$engine"-server "$src"/src/"$engine"-cli "$work/bin/"
    rm -rf "$src"
  else
    tar -xf "$archive" -C "$work" --strip-components=1
  fi
  rm -f "$archive"

  if [[ $engine == mongodb ]]; then ensure_mongosh "$work"; fi
  trim_engine "$work"
  add_compat "$work"
  mv "$work" "$dest"
  echo "$dest"
}

# Drop what a local dev server never uses: test suites, the sharding router,
# and debug symbols (MariaDB ships unstripped, ~1.4 GB → ~300 MB).
trim_engine() {
  rm -rf "$1"/mariadb-test "$1"/mysql-test "$1"/sql-bench "$1"/bin/mongos "$1"/bin/install_compass \
    "$1"/bin/mariadb-test* "$1"/bin/mysql-test* "$1"/lib/*.a
  if command -v strip >/dev/null; then
    # Strip into a new file and rename it over the original: strip rewrites in place,
    # which SIGBUSes any running server that has the old file mapped.
    local f
    while IFS= read -r -d '' f; do
      if strip --strip-debug -o "$f.strip" "$f" 2>/dev/null; then
        chmod --reference="$f" "$f.strip" && mv -f "$f.strip" "$f"
      else
        rm -f "$f.strip"
      fi
    done < <(find "$1/bin" "$1/lib" -type f \( -perm -u+x -o -name '*.so*' \) ! -name '*.strip' -print0 2>/dev/null)
  fi
}

# Upstream builds link libncurses/libtinfo .so.6 (or .so.5); Arch ships the same
# library as libncursesw.so.6. Point the missing names at it, for this engine only.
add_compat() {
  local missing lib
  missing=$(LD_LIBRARY_PATH="$1/compat" find "$1/bin" -maxdepth 1 -type f -perm -u+x -exec ldd {} + 2>/dev/null |
    awk '/not found/ {print $1}' | sort -u)
  for lib in $missing; do
    case $lib in
    # MySQL 8.0's client wants the .so.5 names; it uses only the unversioned termcap calls.
    libncurses.so.6 | libtinfo.so.6 | libncurses.so.5 | libtinfo.so.5)
      mkdir -p "$1/compat"
      ln -sf /usr/lib/libncursesw.so.6 "$1/compat/$lib"
      ;;
    libcrypt.so.1)
      # Arch's libxcrypt-compat package, unpacked next to this engine only.
      local pkg="$HOME_DIR/tmp/libxcrypt-compat.pkg.tar.zst" tmp="$HOME_DIR/tmp/libxcrypt-compat"
      fetch_verified "$(pinned extras libxcrypt-compat)" "$pkg"
      rm -rf "$tmp"
      mkdir -p "$tmp" "$1/compat"
      tar --zstd -xf "$pkg" -C "$tmp" usr/lib
      cp -a "$tmp"/usr/lib/libcrypt.so.1* "$1/compat/"
      rm -rf "$tmp" "$pkg"
      ;;
    esac
  done
}

# Run a binary from an engine with its compat libraries, if it has any.
with_compat() {
  local base=$1
  shift
  if [[ -d $base/compat ]]; then echo "env LD_LIBRARY_PATH=$base/compat $*"; else echo "$*"; fi
}

# MongoDB server builds no longer ship a shell; add mongosh next to mongod.
ensure_mongosh() {
  local archive="$HOME_DIR/tmp/mongosh.tgz"
  fetch_verified "$(pinned extras mongosh)" "$archive"
  tar -xzf "$archive" -C "$1/bin" --strip-components=2 --wildcards '*/bin/mongosh*'
  rm -f "$archive"
}

# ---- Native servers ---------------------------------------------------------

# The command line that runs a native server in the foreground.
native_exec() {
  local engine=$1 base=$2 dir=$3 port=$4
  local data="$dir/data" run="$dir/run"
  case $engine in
  postgresql) echo "$base/bin/postgres -D $data -p $port -c listen_addresses=127.0.0.1 -c unix_socket_directories=$run" ;;
  mysql) echo "$base/bin/mysqld --no-defaults --basedir=$base --datadir=$data --port=$port --bind-address=127.0.0.1 --socket=$run/mysqld.sock --pid-file=$run/mysqld.pid --mysqlx=OFF" ;;
  mariadb) echo "$base/bin/mariadbd --no-defaults --basedir=$base --datadir=$data --port=$port --bind-address=127.0.0.1 --socket=$run/mysqld.sock --pid-file=$run/mysqld.pid" ;;
  redis | valkey) echo "$base/bin/$engine-server $dir/$engine.conf" ;;
  mongodb) echo "$base/bin/mongod --dbpath $data --port $port --bind_ip 127.0.0.1${5:+ --auth}" ;;
  esac
}

native_init() {
  local engine=$1 base=$2 data=$3 user=$4 pass=$5
  if [[ -d $base/compat ]]; then export LD_LIBRARY_PATH=$base/compat; fi
  case $engine in
  postgresql)
    if [[ -n $pass ]]; then
      local pwfile
      pwfile=$(mktemp)
      printf '%s\n' "$pass" >"$pwfile"
      "$base/bin/initdb" -D "$data" -U "$user" --auth=scram-sha-256 --pwfile="$pwfile" -E UTF8 --no-locale >/dev/null
      local rc=$?
      rm -f "$pwfile"
      return $rc
    fi
    "$base/bin/initdb" -D "$data" -U "$user" --auth=trust -E UTF8 --no-locale >/dev/null
    ;;
  mysql) "$base/bin/mysqld" --no-defaults --initialize-insecure --basedir="$base" --datadir="$data" 2>/dev/null ;;
  mariadb)
    "$base/scripts/mariadb-install-db" --no-defaults --basedir="$base" --datadir="$data" \
      --auth-root-authentication-method=normal --skip-test-db >/dev/null
    ;;
  esac
}

write_unit() {
  local name=$1 engine=$2 exact=$3 cmd=$4 kill=SIGTERM
  [[ $engine == postgresql ]] && kill=SIGINT # fast shutdown, no waiting on clients
  mkdir -p "$UNIT_DIR"
  cat >"$UNIT_DIR/$(unit "$name")" <<EOF
# Managed by OmaDBngin (blackcode.omadbngin). Edit the server in the panel, not here.
[Unit]
Description=OmaDBngin $name ($(engine_field "$engine" title) $exact)

[Service]
Type=simple
ExecStart=$cmd
KillSignal=$kill
TimeoutStopSec=60
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
}

# Run SQL as passwordless root on a server started with networking off, then stop it.
provision_mysql() {
  local engine=$1 base=$2 dir=$3 user=$4 pass=$5 tmp daemon=mysqld client=mysql extra=(--mysqlx=OFF) pid
  [[ $engine == mariadb ]] && { daemon=mariadbd; client=mariadb; extra=(); }
  tmp=$(private_tmp)
  if [[ -d $base/compat ]]; then export LD_LIBRARY_PATH=$base/compat; fi
  "$base/bin/$daemon" --no-defaults --basedir="$base" --datadir="$dir/data" --skip-networking \
    --socket="$tmp/s" --pid-file="$tmp/pid" "${extra[@]}" >"$tmp/log" 2>&1 &
  pid=$!
  mysql_apply "$(mysql_setup_sql "$user" "$pass")" "$base/bin/$client" --socket="$tmp/s" -uroot
  MYSQL_PWD=$pass "$base/bin/$client" --socket="$tmp/s" -uroot -e SHUTDOWN >/dev/null 2>&1 || kill "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null
  rm -rf "$tmp"
}

# Create the MongoDB user on a server that has auth on from the start and listens only on a
# private socket: the localhost exception lets that first user in, and only us.
provision_mongodb() {
  local base=$1 dir=$2 port=$3 user=$4 pass=$5 tmp sock pid i
  tmp=$(private_tmp)
  sock="$tmp/mongodb-$port.sock"
  if [[ -d $base/compat ]]; then export LD_LIBRARY_PATH=$base/compat; fi
  "$base/bin/mongod" --dbpath "$dir/data" --port "$port" --auth --bind_ip "$sock" --unixSocketPrefix "$tmp" \
    --filePermissions 0700 >"$tmp/log" 2>&1 &
  pid=$!
  local url out="" ok=""
  url="mongodb://$(uri "$sock")/admin"
  export OMADBNGIN_USER OMADBNGIN_PW=$pass
  OMADBNGIN_USER=$(jq -nc --arg u "$user" '{user: $u, roles: [{role: "root", db: "admin"}]}')
  # A busy machine can take a while to bring mongod up: keep trying while it runs.
  for i in $(seq 1 120); do
    kill -0 "$pid" 2>/dev/null || break
    if [[ -S $sock ]] && out=$("$base/bin/mongosh" --quiet "$url" \
      --eval 'db.createUser(Object.assign(JSON.parse(process.env.OMADBNGIN_USER), {pwd: process.env.OMADBNGIN_PW}))' 2>&1); then
      ok=1
      break
    fi
    sleep 1
  done
  unset OMADBNGIN_PW
  if [[ -z $ok ]]; then
    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    out=${out:-$(grep -o '"msg":"[^"]*"' "$tmp/log" | tail -1)}
    rm -rf "$tmp"
    fail "creating the MongoDB user failed: $(tail -1 <<<"$out")"
  fi
  kill "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null
  rm -rf "$tmp"
}

create_native() {
  local engine=$1 version=$2 name=$3 port=$4 autostart=$5 user=$6 pass=$7
  local base exact dir
  base=$(ensure_engine "$engine" "$version")
  exact=${base##*/}
  dir=$(server_dir "$name")
  [[ -e $dir ]] && fail "$dir already exists"
  mkdir -p "$dir/data" "$dir/run"
  chmod 700 "$dir"
  if ! native_init "$engine" "$base" "$dir/data" "$user" "$pass"; then
    rm -rf "$dir"
    fail "initializing $engine $exact failed"
  fi
  if [[ $engine == redis || $engine == valkey ]]; then
    {
      printf 'port %s\nbind 127.0.0.1\ndir %s\nappendonly yes\ndaemonize no\nprotected-mode no\n' "$port" "$dir/data"
      redis_auth_conf "$user" "$pass"
    } >"$dir/$engine.conf"
    chmod 600 "$dir/$engine.conf"
  fi
  (umask 077 && OMADBNGIN_PW=$pass jq -n --arg name "$name" --arg engine "$engine" --arg version "$version" --arg exact "$exact" \
    --argjson port "$port" --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg user "$user" \
    '{name: $name, engine: $engine, version: $version, exact: $exact, port: $port, created: $created, mode: "native",
      user: $user, password: env.OMADBNGIN_PW}' >"$dir/server.json")
  chmod 600 "$dir/server.json"

  # Users are set up before the server ever listens on TCP, on a socket only we can reach:
  # nobody else can slip in while root has no password or MongoDB has no user yet.
  local auth=""
  case $engine in
  mysql | mariadb) [[ $user == root && -z $pass ]] || provision_mysql "$engine" "$base" "$dir" "$user" "$pass" ;;
  mongodb) [[ -z $user ]] || { provision_mongodb "$base" "$dir" "$port" "$user" "$pass"; auth=auth; } ;;
  esac
  write_unit "$name" "$engine" "$exact" "$(with_compat "$base" "$(native_exec "$engine" "$base" "$dir" "$port" $auth)")"
  systemctl --user start "$(unit "$name")"
  [[ $autostart == on ]] && systemctl --user enable --quiet "$(unit "$name")"
  # Created means ready: wait until the server accepts TCP connections.
  local i
  for i in $(seq 1 60); do
    ss -ltnH "sport = :$port" | grep -q . && return 0
    systemctl --user is-failed --quiet "$(unit "$name")" && fail "$name failed to start; see its logs"
    sleep 1
  done
  fail "$name did not start listening on port $port"
}

# ---- Docker images: pinned by digest -----------------------------------------
#
# engines.lock pins every Docker engine version to <repository>:<tag> plus the digest of
# the tag's multi-arch index, and new servers run <repository>:<tag>@<digest>: Docker
# checks what it pulls against the digest, so a moved or compromised tag upstream cannot
# change the code that gets the server's credentials and data. A version without a pin is
# refused. Regenerate with tools/update-engines-lock docker.

docker_repo() {
  case $1 in
  postgresql) echo postgres ;;
  postgis) echo postgis/postgis ;;
  mysql) echo mysql ;;
  mariadb) echo mariadb ;;
  redis) echo redis ;;
  valkey) echo valkey/valkey ;;
  mongodb) echo mongo ;;
  *) fail "no Docker image for $1" ;;
  esac
}

# pinned_image <engine> <version>: <repository>:<tag>@sha256:<digest>
pinned_image() {
  local repo pin image tag digest
  [[ -f $LOCK ]] || fail "engines.lock is missing; reinstall the plugin"
  repo=$(docker_repo "$1")
  pin=$(jq -r --arg e "$1" --arg l "$2" '.docker[$e][$l] // empty | "\(.image) \(.tag) \(.digest)"' "$LOCK")
  [[ -n $pin ]] || fail "no pinned Docker image for $1 $2 in engines.lock; nothing was created"
  read -r image tag digest <<<"$pin"
  [[ $image == "$repo" && $tag == "$2" ]] || fail "engines.lock pins $image:$tag for $1 $2, expected $repo:$2"
  [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || fail "engines.lock has no valid image digest for $1 $2"
  echo "$repo:$tag@$digest"
}

# image_of <container>: the image to make that container again with: exactly the one it
# runs now. Containers from 1.6.1 on name it by digest already. Older ones name only a tag,
# which may point somewhere else by now, so they get the digest of the image they run
# (or, for an image without one, its local ID); never a fresh pull of the tag.
image_of() {
  local image id repo digest
  image=$(docker inspect -f '{{.Config.Image}}' "$1") || return 1
  if [[ $image == *@sha256:* ]]; then echo "$image"; return; fi
  id=$(docker inspect -f '{{.Image}}' "$1") || return 1
  repo=$image
  [[ ${image##*/} == *:* ]] && repo=${image%:*}
  repo=${repo#docker.io/}
  repo=${repo#library/}
  # RepoDigests name Docker Hub images the short way (postgres@…, postgis/postgis@…).
  digest=$(docker image inspect -f '{{range .RepoDigests}}{{println .}}{{end}}' "$id" 2>/dev/null |
    awk -v r="$repo" 'index($0, r "@sha256:") == 1 { print; exit }')
  if [[ -n $digest ]]; then echo "$image@${digest#*@}"; else echo "$id"; fi
}

create_docker() {
  local engine=$1 version=$2 name=$3 port=$4 autostart=$5 user=$6 pass=$7
  [[ $(docker_status) == running ]] || fail "Docker is not running"
  local image inner data env=() cmd=()
  # (create runs this in a subshell under `if`, where set -e is off: stop explicitly)
  image=$(pinned_image "$engine" "$version") || exit 1
  case $engine in
  postgresql | postgis)
    # postgis/postgis:<major>-<postgis> is the official postgres image plus PostGIS. It turns the
    # extension on in POSTGRES_DB (which defaults to the user's name), so that is postgres here.
    [[ $engine == postgis ]] && env=(-e POSTGRES_DB=postgres)
    inner=5432
    # Postgres 18 images moved PGDATA under /var/lib/postgresql/<major>.
    if ((${version%%[.-]*} >= 18)); then data=/var/lib/postgresql; else data=/var/lib/postgresql/data; fi
    env+=(-e "POSTGRES_USER=$user")
    if [[ -n $pass ]]; then env+=(-e "POSTGRES_PASSWORD=$pass"); else env+=(-e POSTGRES_HOST_AUTH_METHOD=trust); fi
    # (env goes to docker in a private --env-file, not on its command line: see docker_run)
    ;;
  mysql)
    inner=3306
    data=/var/lib/mysql
    # root gets its password while the image initializes (with networking off), so it is
    # never reachable without one
    env=(-e MYSQL_ROOT_HOST=%)
    if [[ -n $pass ]]; then env+=(-e "MYSQL_ROOT_PASSWORD=$pass"); else env+=(-e MYSQL_ALLOW_EMPTY_PASSWORD=yes); fi
    ;;
  mariadb)
    inner=3306
    data=/var/lib/mysql
    if [[ -n $pass ]]; then env=(-e "MARIADB_ROOT_PASSWORD=$pass"); else env=(-e MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=1); fi
    ;;
  redis | valkey)
    inner=6379
    data=/data
    redis_volume_conf "$name" "$image" "$user" "$pass"
    cmd=("$engine-server" /data/omadbngin.conf --appendonly yes)
    ;;
  mongodb)
    inner=27017
    data=/data/db
    [[ -n $user ]] && env=(-e "MONGO_INITDB_ROOT_USERNAME=$user" -e "MONGO_INITDB_ROOT_PASSWORD=$pass")
    ;;
  esac

  docker_run "$name" "$engine" "$version" "$port" "$autostart" "$user" "$pass" "$image" "$inner" "$data" "${#env[@]}" \
    "${env[@]}" "${cmd[@]}"

  if [[ $engine == mysql || $engine == mariadb ]] && ! [[ $user == root && -z $pass ]]; then
    echo "Setting up user $user…" >&2
    MYSQL_PWD=$pass mysql_apply "$(mysql_setup_sql "$user" "$pass")" \
      docker exec -i -e MYSQL_PWD "$(container "$name")" "$engine" -h127.0.0.1 -uroot
  fi
}

# Docker Redis/Valkey: the auth settings live in /data/omadbngin.conf on the server's volume
# (written through stdin), so they are not in the container's command line, which every
# local account sees in ps.
redis_volume_conf() {
  local name=$1 image=$2 user=$3 pass=$4
  docker volume create "$(container "$name")" >/dev/null
  redis_auth_conf "$user" "$pass" |
    docker run --rm -i -v "$(container "$name"):/data" --entrypoint sh "$image" -c \
      'cat >/data/omadbngin.conf && chmod 600 /data/omadbngin.conf && chown "$(stat -c %u:%g /data)" /data/omadbngin.conf' ||
    fail "writing the server's settings failed"
}

# The managed container itself; env and cmd follow as: <env count> <env…> <cmd…>.
docker_run() {
  local name=$1 engine=$2 version=$3 port=$4 autostart=$5 user=$6 pass=$7 image=$8 inner=$9 data=${10} n=${11}
  shift 11
  local env=("${@:1:n}") cmd=("${@:n+1}")
  local restart=no
  [[ $autostart == on ]] && restart=unless-stopped

  # The password label and the environment (passwords for the image's first start) go in
  # private files, not on docker's command line.
  local tmp i
  tmp=$(private_tmp)
  printf 'omadbngin.password=%s\n' "$pass" >"$tmp/labels"
  : >"$tmp/env"
  for ((i = 0; i < ${#env[@]}; i++)); do [[ ${env[i]} == -e ]] || printf '%s\n' "${env[i]}" >>"$tmp/env"; done

  docker run -d --quiet \
    --name "$(container "$name")" \
    --label "$LABEL" \
    --label "omadbngin.name=$name" \
    --label "omadbngin.engine=$engine" \
    --label "omadbngin.version=$version" \
    --label "omadbngin.port=$port" \
    --label "omadbngin.user=$user" \
    --label-file "$tmp/labels" \
    --env-file "$tmp/env" \
    --restart "$restart" \
    -p "127.0.0.1:$port:$inner" \
    -v "$(container "$name"):$data" \
    "$image" "${cmd[@]}" >/dev/null
  local rc=$?
  rm -rf "$tmp"
  return $rc
}

# ---- Moving from OmaDB --------------------------------------------------------
# This plugin was called OmaDB (blackcode.omadb): data in ~/.local/share/omadb,
# services omadb-<name>.service, containers and volumes omadb-<name> labelled
# omadb.*. The first run after the rename moves all of it over once, keeping
# each server's data, port, credentials, autostart and running state.

LEGACY_HOME="${OMADBNGIN_LEGACY_HOME:-$HOME/.local/share/omadb}"
LEGACY_PREFIX="omadb-"

migrate_native() {
  local s dir name engine exact port user base auth=() running=() enabled=()
  for s in "$LEGACY_HOME"/servers/*/server.json; do
    [[ -f $s ]] || continue
    name=$(jq -r .name "$s")
    systemctl --user is-active --quiet "$LEGACY_PREFIX$name.service" && running+=("$name")
    systemctl --user is-enabled --quiet "$LEGACY_PREFIX$name.service" 2>/dev/null && enabled+=("$name")
    systemctl --user disable --now --quiet "$LEGACY_PREFIX$name.service" 2>/dev/null || true
    rm -f "$UNIT_DIR/$LEGACY_PREFIX$name.service"
  done
  systemctl --user daemon-reload 2>/dev/null || true
  mv "$LEGACY_HOME" "$HOME_DIR"
  for s in "$SERVERS_DIR"/*/server.json; do
    [[ -f $s ]] || continue
    dir=${s%/server.json}
    name=$(jq -r .name "$s")
    engine=$(jq -r .engine "$s")
    exact=$(jq -r .exact "$s")
    port=$(jq -r .port "$s")
    user=$(jq -r '.user // ""' "$s")
    base="$ENGINES_DIR/$engine/$exact"
    # Redis/Valkey configs name their data directory by absolute path.
    [[ -f $dir/$engine.conf ]] && sed -i "s#$LEGACY_HOME/#$HOME_DIR/#g" "$dir/$engine.conf"
    auth=()
    [[ $engine == mongodb && -n $user ]] && auth=(auth)
    write_unit "$name" "$engine" "$exact" "$(with_compat "$base" "$(native_exec "$engine" "$base" "$dir" "$port" "${auth[@]}")")"
    [[ " ${enabled[*]} " == *" $name "* ]] && systemctl --user enable --quiet "$(unit "$name")"
    [[ " ${running[*]} " == *" $name "* ]] && systemctl --user start "$(unit "$name")"
  done
}

migrate_docker() {
  local old name engine version port user pass image inner data restart running autostart mounts
  # 1.7: once a pass with Docker up has run, OmaDB containers are gone for good; skip the check
  local marker="$HOME_DIR/.omadb-docker-migrated"
  [[ -e $marker ]] && return 0
  [[ $(docker_status) == running ]] || return 0
  for old in $(docker ps -a --filter "label=omadb.managed=1" --format '{{.Names}}'); do
    name=$(docker inspect -f '{{index .Config.Labels "omadb.name"}}' "$old")
    [[ -n $name && -z $(mode_of "$name") ]] || continue
    engine=$(docker inspect -f '{{index .Config.Labels "omadb.engine"}}' "$old")
    version=$(docker inspect -f '{{index .Config.Labels "omadb.version"}}' "$old")
    port=$(docker inspect -f '{{index .Config.Labels "omadb.port"}}' "$old")
    user=$(docker inspect -f '{{index .Config.Labels "omadb.user"}}' "$old")
    pass=$(docker inspect -f '{{index .Config.Labels "omadb.password"}}' "$old")
    image=$(image_of "$old")
    restart=$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$old")
    running=$(docker inspect -f '{{.State.Running}}' "$old")
    data=$(docker inspect -f '{{range .Mounts}}{{if eq .Name "'"$old"'"}}{{.Destination}}{{end}}{{end}}' "$old")
    inner=$(docker inspect -f '{{range $p, $b := .HostConfig.PortBindings}}{{$p}}{{end}}' "$old")
    inner=${inner%%/*}
    autostart=off
    [[ $restart == unless-stopped || $restart == always ]] && autostart=on
    [[ -n $data && -n $inner ]] || { echo "dbctl: left $old as it was: cannot read its volume or port" >&2; continue; }
    echo "Moving container $old to $(container "$name")…" >&2
    docker stop "$old" >/dev/null
    # Copy the data into a volume with the new name; the old volume stays until you remove it.
    docker volume create "$(container "$name")" >/dev/null
    if ! docker run --rm -v "$old:/from" -v "$(container "$name"):/to" --entrypoint sh "$image" -c 'cp -a /from/. /to/'; then
      docker volume rm "$(container "$name")" >/dev/null 2>&1 || true
      [[ $running == true ]] && docker start "$old" >/dev/null
      echo "dbctl: left $old as it was: copying its data failed" >&2
      continue
    fi
    local cmd=() env=() e
    mapfile -t cmd < <(docker inspect -f '{{range .Config.Cmd}}{{println .}}{{end}}' "$old" | sed '/^$/d')
    # The settings dbctl passed at creation (the image's own variables come back by themselves).
    while IFS= read -r e; do [[ -n $e ]] && env+=(-e "$e"); done < <(
      docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$old" | grep -E '^(POSTGRES|MYSQL|MARIADB|MONGO_INITDB)_')
    docker rm "$old" >/dev/null
    if [[ $engine == redis || $engine == valkey ]]; then
      redis_volume_conf "$name" "$image" "$user" "$pass"
      cmd=("$engine-server" /data/omadbngin.conf --appendonly yes)
    fi
    docker_run "$name" "$engine" "$version" "$port" "$autostart" "$user" "$pass" "$image" "$inner" "$data" "${#env[@]}" \
      "${env[@]}" "${cmd[@]}"
    [[ $running == true ]] || docker stop "$(container "$name")" >/dev/null
    echo "dbctl: $name now uses volume $(container "$name"); the old volume $old can be removed with: docker volume rm $old" >&2
  done
  # nothing left to move (a failed copy stays and is tried again next time)
  [[ -z $(docker ps -aq --filter "label=omadb.managed=1") ]] && mkdir -p "$HOME_DIR" && : >"$marker"
  return 0
}

migrate_legacy() {
  # Only for the default locations (tests set both), and only once: the new directory existing means done.
  [[ -z ${OMADBNGIN_HOME:-} || -n ${OMADBNGIN_LEGACY_HOME:-} ]] || return 0
  if [[ ! -e $HOME_DIR && -d $LEGACY_HOME ]]; then
    echo "Moving OmaDB servers to OmaDBngin…" >&2
    migrate_native
  fi
  migrate_docker
}

# ---- Commands ---------------------------------------------------------------

# ---- 1.7: stats, sizes, stacks, connection formats -------------------------------

FULL=0

# cgroup v2 counters of a cgroup directory: "<cpu usec> <memory bytes>"
cg_read() {
  local d=$1 cpu=0 mem=0 k v
  [[ -r $d/cpu.stat ]] && while read -r k v; do [[ $k == usage_usec ]] && cpu=$v && break; done <"$d/cpu.stat"
  [[ -r $d/memory.current ]] && mem=$(<"$d/memory.current")
  echo "$cpu $mem"
}

# Only for `state --full` (the panel is open): CPU time, memory and a TCP readiness check for
# each running server, from kernel files and one connect each. Never docker stats.
stats_of() {
  ((FULL)) || { echo "{}"; return; }
  printf '%s\n%s\n' "$1" "$2" | jq -r '.[] | select(.running) | [.name, (.port|tostring), (.cid // ""), (.cgroup // "")] | @tsv' |
    while IFS=$'\t' read -r name port cid cg; do
      local dir="" cpu mem ready=false
      if [[ -n $cid ]]; then
        for dir in "/sys/fs/cgroup/system.slice/docker-$cid.scope" "/sys/fs/cgroup/docker/$cid"; do [[ -d $dir ]] && break; done
      elif [[ -n $cg ]]; then
        dir="/sys/fs/cgroup$cg"
      fi
      read -r cpu mem < <(cg_read "$dir")
      (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && ready=true
      [[ $cpu =~ ^[0-9]+$ ]] || cpu=0
      [[ $mem =~ ^[0-9]+$ ]] || mem=0
      # server names are [a-z0-9-] only: safe to write as JSON directly
      if ((mem > 0)); then printf '"%s":{"cpuUsec":%s,"ready":%s,"memory":%s}\n' "$name" "$cpu" "$ready" "$mem"
      else printf '"%s":{"cpuUsec":%s,"ready":%s}\n' "$name" "$cpu" "$ready"; fi
    done | { mapfile -t parts; local IFS=,; echo "{${parts[*]}}"; }
}

# sizes: data size per server, cached for 5 minutes (only asked for while the panel is open).
# Docker volumes live under /var/lib/docker, readable only by root: those stay null.
cmd_sizes() {
  local cache="$HOME_DIR/.sizes.json"
  if [[ -f $cache && $(($(date +%s) - $(stat -c %Y "$cache"))) -lt 300 ]]; then cat "$cache"; return; fi
  local out="{}" f name size mp
  if compgen -G "$SERVERS_DIR/*/server.json" >/dev/null; then
    for f in "$SERVERS_DIR"/*/server.json; do
      name=$(basename "$(dirname "$f")")
      size=$(du -sb "$(dirname "$f")/data" 2>/dev/null | cut -f1)
      out=$(jq -c --arg n "$name" --argjson s "${size:-null}" '. + {($n): $s}' <<<"$out")
    done
  fi
  if [[ $(docker_status) == running ]]; then
    while read -r name; do
      [[ -n $name ]] || continue
      mp=$(docker volume inspect -f '{{.Mountpoint}}' "$(container "$name")" 2>/dev/null || true)
      size=""
      [[ -n $mp && -r $mp ]] && size=$(du -sb "$mp" 2>/dev/null | cut -f1)
      out=$(jq -c --arg n "$name" --argjson s "${size:-null}" '. + {($n): $s}' <<<"$out")
    done < <(docker ps -a --filter "label=$LABEL" --format '{{.Label "omadbngin.name"}}')
  fi
  mkdir -p "$HOME_DIR"
  printf '%s\n' "$out" | tee "$cache"
}

stacks_json() {
  [[ -f $STACKS ]] && jq -c 'if type == "object" then with_entries(select(.value | type == "array" and length > 0)) else {} end' "$STACKS" 2>/dev/null ||
    echo "{}"
}

stacks_write() {
  mkdir -p "$HOME_DIR"
  local tmp="$STACKS.tmp-$$"
  printf '%s\n' "$1" >"$tmp" && mv "$tmp" "$STACKS"
}

stack_unset() {
  local next
  next=$(stacks_json | jq -c --arg n "$1" 'map_values(map(select(. != $n))) | with_entries(select(.value | length > 0))')
  stacks_write "$next"
}

valid_stack() { [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,30}$ ]] || fail "stack names: letters, digits, . _ -, up to 31"; }

cmd_stack() {
  local sub=${1:-} n
  case $sub in
  list) stacks_json ;;
  add)
    valid_stack "${2:-}"
    require_managed "${3:-}"
    stack_unset "$3"
    stacks_write "$(stacks_json | jq -c --arg s "$2" --arg n "$3" '.[$s] = ((.[$s] // []) + [$n] | unique)')"
    ;;
  remove) [[ -n ${2:-} ]] || fail "usage: stack remove <name>"; stack_unset "$2" ;;
  delete) valid_stack "${2:-}"; stacks_write "$(stacks_json | jq -c --arg s "$2" 'del(.[$s])')" ;;
  start | stop)
    valid_stack "${2:-}"
    for n in $(stacks_json | jq -r --arg s "$2" '.[$s] // [] | .[]'); do
      cmd_power "$sub" "$n" || echo "dbctl: could not $sub $n" >&2
    done
    ;;
  *) fail "usage: stack list | add <stack> <name> | remove <name> | delete <stack> | start|stop <stack>" ;;
  esac
}

# conn <name> [format]: the connection in a form a tool or framework takes
cmd_conn() {
  local name=${1:-} format=${2:-url} engine flavor port url
  require_managed "$name"
  engine=$(kind_of "$(field_of "$name" engine)")
  port=$(field_of "$name" port)
  creds_of "$name"
  url=$(cmd_url "$name")
  local q
  q() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }
  case $format in
  url) echo "$url" ;;
  env)
    case $engine in
    redis | valkey) echo "REDIS_URL=$url" ;;
    mongodb) echo "MONGODB_URI=$url" ;;
    *) echo "DATABASE_URL=$url" ;;
    esac
    ;;
  laravel)
    case $engine in
    postgresql) printf 'DB_CONNECTION=pgsql\nDB_HOST=127.0.0.1\nDB_PORT=%s\nDB_DATABASE=postgres\nDB_USERNAME=%s\nDB_PASSWORD=%s\n' "$port" "$USER_" "$PASS_" ;;
    mysql | mariadb) printf 'DB_CONNECTION=%s\nDB_HOST=127.0.0.1\nDB_PORT=%s\nDB_DATABASE=\nDB_USERNAME=%s\nDB_PASSWORD=%s\n' "$engine" "$port" "$USER_" "$PASS_" ;;
    redis | valkey)
      printf 'REDIS_CLIENT=phpredis\nREDIS_HOST=127.0.0.1\nREDIS_PORT=%s\nREDIS_PASSWORD=%s\n' "$port" "${PASS_:-null}"
      if [[ $USER_ != default && -n $USER_ ]]; then printf 'REDIS_USERNAME=%s\n' "$USER_"; fi
      ;;
    mongodb) printf 'DB_CONNECTION=mongodb\nMONGODB_URI=%s\n' "$url" ;;
    esac
    ;;
  django)
    case $engine in
    postgresql | mysql | mariadb)
      local backend=postgresql db=postgres
      [[ $engine != postgresql ]] && backend=mysql db=""
      printf "DATABASES = {\n    \"default\": {\n        \"ENGINE\": \"django.db.backends.%s\",\n        \"NAME\": \"%s\",\n        \"USER\": \"%s\",\n        \"PASSWORD\": \"%s\",\n        \"HOST\": \"127.0.0.1\",\n        \"PORT\": \"%s\",\n    }\n}\n" \
        "$backend" "$db" "$USER_" "$PASS_" "$port"
      ;;
    redis | valkey)
      printf "CACHES = {\n    \"default\": {\n        \"BACKEND\": \"django.core.cache.backends.redis.RedisCache\",\n        \"LOCATION\": \"%s\",\n    }\n}\n" "$url"
      ;;
    *) fail "no Django format for $engine" ;;
    esac
    ;;
  jdbc)
    local qs="" sep="?"
    [[ -n $USER_ ]] && qs+="${sep}user=$(uri "$USER_")" && sep="&"
    [[ -n $PASS_ ]] && qs+="${sep}password=$(uri "$PASS_")"
    case $engine in
    postgresql) echo "jdbc:postgresql://127.0.0.1:$port/postgres$qs" ;;
    mysql | mariadb) echo "jdbc:$engine://127.0.0.1:$port/$qs" ;;
    *) fail "no JDBC format for $engine" ;;
    esac
    ;;
  cli)
    case $engine in
    postgresql) echo "psql '$(q "$url")'" ;;
    mysql | mariadb) echo "$engine -h127.0.0.1 -P$port -u'$(q "$USER_")'${PASS_:+ -p'$(q "$PASS_")'}" ;;
    redis | valkey) echo "$engine-cli -u '$(q "$url")'" ;;
    mongodb) echo "mongosh '$(q "$url")'" ;;
    esac
    ;;
  *) fail "unknown format: $format (url env laravel django jdbc cli)" ;;
  esac
}

# tail <name>: the last 200 log lines, then follow; the panel reads this while its log view is open
cmd_tail() {
  require_managed "${1:-}"
  if [[ $MODE == native ]]; then
    exec journalctl --user -u "$(unit "$1")" -f -n 200 -o cat
  else
    exec docker logs -f --tail 200 "$(container "$1")" 2>&1
  fi
}

BINDINGS="$HOME/.config/hypr/bindings.lua"
BIND_KEYS="SUPER + ALT + D"
BIND_MARK="-- OmaDBngin panel (dbctl unbind removes these two lines)"
BIND_LINE="o.bind(\"$BIND_KEYS\", \"OmaDBngin\", \"qs -p /usr/share/omarchy/shell ipc call blackcode.omadbngin toggle\")"

cmd_bind() {
  local file=${OMADBNGIN_BINDINGS:-$BINDINGS} text
  [[ -f $file ]] || fail "no $file"
  text=$(<"$file")
  if grep -qxF "$BIND_LINE" "$file"; then echo "already bound: SUPER+ALT+D opens OmaDBngin"; return; fi
  grep -qF "\"$BIND_KEYS\"" "$file" && fail "$BIND_KEYS is already bound in $file; nothing was changed"
  { [[ -z $text ]] || printf '%s\n' "$text"; printf '%s\n%s\n' "$BIND_MARK" "$BIND_LINE"; } >"$file.tmp-$$" && mv "$file.tmp-$$" "$file"
  [[ $file == "$BINDINGS" ]] && { hyprctl reload >/dev/null 2>&1 || true; }
  echo "bound: SUPER+ALT+D opens OmaDBngin ('dbctl unbind' removes it)"
}

cmd_unbind() {
  local file=${OMADBNGIN_BINDINGS:-$BINDINGS}
  [[ -f $file ]] && grep -qxF "$BIND_LINE" "$file" || { echo "not bound; nothing to remove"; return; }
  grep -vxF -e "$BIND_MARK" -e "$BIND_LINE" "$file" >"$file.tmp-$$" || true
  mv "$file.tmp-$$" "$file"
  [[ $file == "$BINDINGS" ]] && { hyprctl reload >/dev/null 2>&1 || true; }
  echo "unbound SUPER+ALT+D"
}

# The panel asks for state every few seconds while open: talk to the Docker socket with curl
# (~4 ms) when we may, the docker client (~15 ms each) otherwise. Same JSON either way.
docker_sock() {
  local sock=${DOCKER_HOST:-unix:///var/run/docker.sock}
  sock=${sock#unix://}
  [[ -S $sock && -w $sock ]] && command -v curl >/dev/null && echo "$sock"
}

docker_ids() {
  local sock
  if sock=$(docker_sock); then
    curl -sf --unix-socket "$sock" 'http://docker/containers/json?all=1&filters=%7B%22label%22%3A%5B%22omadbngin.managed%3D1%22%5D%7D' |
      { grep -oE '"Id":"[0-9a-f]{64}"' || true; } | cut -d'"' -f4
  else
    docker ps -aq --filter "label=$LABEL"
  fi
}

# docker_inspect <id...>: a JSON array, like `docker inspect`
docker_inspect() {
  local sock id urls=()
  if sock=$(docker_sock); then
    for id in "$@"; do urls+=("http://docker/containers/$id/json"); done
    curl -sf --unix-socket "$sock" "${urls[@]}" | jq -sc .
  else
    docker inspect "$@"
  fi
}

# setup: what a user would otherwise do by hand after installing, done once. The widget runs
# it on every shell start; after the first run the marker makes it a no-op, so an `unbind`
# (or anything else the user changes later) is never redone.
cmd_setup() {
  local marker="$HOME_DIR/.setup-done" file=${OMADBNGIN_BINDINGS:-$BINDINGS}
  [[ -e $marker ]] && { echo "already set up"; return; }
  mkdir -p "$HOME_DIR"
  exec 9>"${XDG_RUNTIME_DIR:-$HOME_DIR}/omadbngin-setup.lock"
  flock 9
  [[ -e $marker ]] && { echo "already set up"; return; }
  if [[ -f $file ]] && ! grep -qF "\"$BIND_KEYS\"" "$file"; then
    cmd_bind
  else
    echo "SUPER+ALT+D is taken or there is no $file: no shortcut added (the panel has the settings)"
  fi
  : >"$marker"
}

cmd_state() {
  local status engines docker_services="[]" native_services="[]" installed="[]"
  status=$(docker_status)

  engines=$(printf '%s\n' "${ENGINES[@]}")

  if [[ -d $ENGINES_DIR && -f $LOCK ]]; then
    # Only the pinned builds count: an older download of a line is not what a new server gets.
    installed=$(jq -r '.engines | to_entries[] | .key as $e | .value | to_entries[]
        | "\($e)/\(.value.version)\t" + ({engine: $e, line: .key, exact: .value.version} | tojson)' "$LOCK" |
      while IFS=$'\t' read -r dir i; do
        # `if`, not `&&`: a last line that is not installed must not fail the pipeline (pipefail)
        if [[ -d $ENGINES_DIR/$dir ]]; then echo "$i"; fi
      done | jq -sc .)
  fi

  if [[ $status == running ]]; then
    local ids
    ids=$(docker_ids)
    if [[ -n $ids ]]; then
      # shellcheck disable=SC2086
      docker_services=$(docker_inspect $ids | jq -c '[.[] | {
        name: .Config.Labels["omadbngin.name"],
        engine: .Config.Labels["omadbngin.engine"],
        version: .Config.Labels["omadbngin.version"],
        exact: .Config.Labels["omadbngin.version"],
        port: (.Config.Labels["omadbngin.port"] | tonumber),
        user: .Config.Labels["omadbngin.user"],
        password: (.Config.Labels["omadbngin.password"] // ""),
        created: .Created,
        mode: "docker",
        state: .State.Status,
        health: (.State.Health.Status // ""),
        running: .State.Running,
        since: (if .State.Running then (.State.StartedAt | sub("\\.[0-9]+"; "") | fromdateiso8601) else 0 end),
        error: (.State.Error // ""),
        exitCode: (.State.ExitCode // 0),
        oom: (.State.OOMKilled // false),
        cid: .Id,
        autostart: (.HostConfig.RestartPolicy.Name == "unless-stopped" or .HostConfig.RestartPolicy.Name == "always")
      }]')
    fi
  fi

  if compgen -G "$SERVERS_DIR/*/server.json" >/dev/null; then
    # one systemctl call for every server's state, autostart, memory and start time
    local -A props=()
    local f n="" key value
    local -a units=()
    for f in "$SERVERS_DIR"/*/server.json; do units+=("$(unit "$(basename "$(dirname "$f")")")"); done
    while IFS='=' read -r key value; do
      case $key in
      Id) n=$value ;;
      ActiveState | UnitFileState | MemoryCurrent | ActiveEnterTimestamp | ControlGroup) props[$n.$key]=$value ;;
      esac
    done < <(systemctl --user show -p Id,ActiveState,UnitFileState,MemoryCurrent,ActiveEnterTimestamp,ControlGroup "${units[@]}" 2>/dev/null)
    native_services=$(for f in "$SERVERS_DIR"/*/server.json; do
      local name active enabled state mem since u
      name=$(basename "$(dirname "$f")")
      u=$(unit "$name")
      active=${props[$u.ActiveState]:-}
      enabled=${props[$u.UnitFileState]:-}
      mem=${props[$u.MemoryCurrent]:-0}
      [[ $mem =~ ^[0-9]+$ ]] || mem=0
      since=${props[$u.ActiveEnterTimestamp]:-}
      case $active in
      active) state=running ;;
      activating | reloading) state=restarting ;;
      failed) state=failed ;;
      *) state=exited ;;
      esac
      # the last error when it failed; disk sizes come from `dbctl sizes`, only while the panel is open
      local err=""
      since=$([[ -n $since && $state == running ]] && date -d "$since" +%s 2>/dev/null || echo 0)
      [[ $state == failed ]] && err=$(journalctl --user -u "$(unit "$name")" -n 30 --no-pager -o cat 2>/dev/null |
        grep -iE 'error|fatal|panic|failed|denied|in use' | grep -v 'Failed with result' | tail -1 | cut -c1-200)
      jq -c --arg state "$state" --arg enabled "$enabled" --argjson mem "$mem" --argjson since "${since:-0}" \
        --arg err "$err" --arg cg "${props[$u.ControlGroup]:-}" \
        '. + {state: $state, health: "", running: ($state == "running"), autostart: ($enabled == "enabled"),
              memory: $mem, since: $since, error: $err, exitCode: 0, oom: false, cgroup: $cg}' "$f"
    done | jq -sc .)
  fi

  # the server lists carry passwords: they reach jq on stdin, not as arguments
  printf '%s\n%s\n%s\n' "$docker_services" "$native_services" "$(stats_of "$docker_services" "$native_services")" |
    jq -sc --arg docker "$status" --arg enginesRaw "$engines" --argjson installed "$installed" --argjson stacks "$(stacks_json)" \
    --argjson omatable "$([[ -d $HOME/.config/omarchy/plugins/blackcode.omatableplus ]] && echo true || echo false)" \
    '.[0] as $a | .[1] as $b | .[2] as $st
     | ($enginesRaw | split("\n") | map(select(. != "") | split("|")
        | {id: .[0], title: .[1], port: (.[2] | tonumber), versions: (.[3] | split(" ")), dockerOnly: (.[4] == "docker")})) as $engines
     | def user0: {postgresql: "postgres", mysql: "root", mariadb: "root", redis: "default", valkey: "default"}[.engine] // "";
     ($stacks | to_entries | map(.key as $k | .value[] | {key: ., value: $k}) | from_entries) as $member |
     {docker: $docker, engines: $engines, installed: $installed, omatable: $omatable, stacks: ($stacks | keys),
      # PostGIS servers are PostgreSQL to every client (OmaTablePlus too); flavor names the image.
      services: ($a + $b | map(if .engine == "postgis" then .flavor = "postgis" | .engine = "postgresql" else . end)
        | map(.user = (.user // (. | user0)) | .password = (.password // ""))
        | map(.stack = ($member[.name] // "") | . + ($st[.name] // {}) | del(.cgroup, .cid))
        | sort_by(.created | sub("\\.[0-9]+"; "") | sub("Z$"; "+00:00")
            | capture("^(?<t>.{19})(?<s>[+-])(?<h>..):(?<m>..)$")
            | (.t + "Z" | fromdateiso8601) - ((if .s == "+" then 1 else -1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60))))}'
}

cmd_create() {
  # the password: better from OMADBNGIN_PASSWORD than as an argument, which other accounts can see
  local engine=${1:-} version=${2:-} name=${3:-} port=${4:-} autostart=${5:-off} mode=${6:-docker} user=${7:-} pass=${8:-${OMADBNGIN_PASSWORD:-}}
  [[ -n $engine && -n $version && -n $name ]] || fail "usage: create <engine> <version> <name> <port> <on|off> [native|docker]"
  [[ $name =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] || fail "name: lowercase letters, digits and dashes"
  [[ " $(engine_field "$engine" versions) " == *" $version "* ]] || fail "unsupported $engine version: $version"
  [[ $mode == native || $mode == docker ]] || fail "mode must be native or docker"
  [[ $mode == native && $(engine_field "$engine" only) == docker ]] && fail "$(engine_field "$engine" title) runs in Docker only"
  # Docker runs only images pinned by digest in engines.lock.
  [[ $mode == docker ]] && { pinned_image "$engine" "$version" >/dev/null || exit 1; }
  [[ -z $user && -n $pass && $engine == mongodb ]] && user=admin
  [[ -z $user ]] && user=$(default_user "$engine")
  [[ -z $user || $user =~ ^[A-Za-z_][A-Za-z0-9_.-]{0,31}$ ]] || fail "username: letters, digits, _ . - (up to 32)"
  [[ $pass =~ ^[^[:space:]\'\"\`\\\$]*$ ]] || fail "password: no spaces, quotes, backslashes or \$"
  ((${#pass} <= 64)) || fail "password: up to 64 characters"
  [[ $engine == mongodb && -n $user && -z $pass ]] && fail "MongoDB needs a password for user $user"
  [[ -z $port ]] && port=$(next_port "$engine")
  [[ $port =~ ^[0-9]+$ ]] && ((port >= 1024 && port <= 65535)) || fail "port must be 1024–65535"
  [[ -z $(mode_of "$name") ]] || fail "a server named $name already exists"
  port_taken "$port" && fail "port $port is already in use"
  # The name was free a moment ago, so on failure everything under it is ours to undo.
  if ! ("create_$mode" "$engine" "$version" "$name" "$port" "$autostart" "$user" "$pass"); then
    if [[ -n $(mode_of "$name") || -e $(server_dir "$name") ]]; then
      MODE=$(mode_of "$name")
      if [[ -z $MODE ]]; then rm -rf "$(server_dir "$name")"; else cmd_remove "$name" >/dev/null 2>&1; fi
    fi
    exit 1
  fi
}

cmd_power() {
  local action=$1 name=${2:-}
  require_managed "$name"
  if [[ $MODE == native ]]; then
    systemctl --user "$action" "$(unit "$name")"
  else
    docker "$action" "$(container "$name")" >/dev/null
  fi
}

cmd_remove() {
  local name=${1:-} keep=${2:-}
  require_managed "$name"
  if [[ $MODE == native ]]; then
    systemctl --user disable --now --quiet "$(unit "$name")" 2>/dev/null || true
    rm -f "$UNIT_DIR/$(unit "$name")"
    systemctl --user daemon-reload
    if [[ $keep == --keep-data ]]; then
      mv "$(server_dir "$name")" "$(server_dir "$name").removed-$(date +%Y%m%d-%H%M%S)"
    else
      rm -rf "$(server_dir "$name")"
    fi
  else
    docker rm -f "$(container "$name")" >/dev/null
    [[ $keep == --keep-data ]] || docker volume rm "$(container "$name")" >/dev/null 2>&1 || true
  fi
  stack_unset "$name"
}

cmd_autostart() {
  require_managed "${1:-}"
  if [[ $MODE == native ]]; then
    if [[ ${2:-} == on ]]; then
      systemctl --user enable --quiet "$(unit "$1")"
    else
      systemctl --user disable --quiet "$(unit "$1")"
    fi
  else
    local policy=no
    [[ ${2:-} == on ]] && policy=unless-stopped
    docker update --restart "$policy" "$(container "$1")" >/dev/null
  fi
}

# user and password of a server; older servers predate them and use the defaults
creds_of() {
  USER_=$(field_of "$1" user)
  PASS_=$(field_of "$1" password)
  [[ $USER_ == null || $USER_ == "<no value>" ]] && USER_=$(default_user "$(field_of "$1" engine)")
  [[ $PASS_ == null || $PASS_ == "<no value>" ]] && PASS_=""
  return 0
}

cmd_url() {
  require_managed "${1:-}"
  local engine port auth=""
  engine=$(kind_of "$(field_of "$1" engine)")
  port=$(field_of "$1" port)
  creds_of "$1"
  if [[ -n $USER_ ]]; then
    auth=$(uri "$USER_")
    [[ -n $PASS_ ]] && auth+=":$(uri "$PASS_")"
    auth+="@"
  fi
  case $engine in
  postgresql) echo "postgresql://${auth}127.0.0.1:$port/postgres" ;;
  mysql | mariadb) echo "mysql://${auth}127.0.0.1:$port" ;;
  redis | valkey)
    if [[ $USER_ == default ]]; then
      [[ -n $PASS_ ]] && auth=":$(uri "$PASS_")@" || auth=""
    fi
    echo "redis://${auth}127.0.0.1:$port"
    ;;
  mongodb) echo "mongodb://${auth}127.0.0.1:$port${auth:+/?authSource=admin}" ;;
  esac
}

cmd_client() {
  require_managed "${1:-}"
  local engine port url
  engine=$(kind_of "$(field_of "$1" engine)")
  port=$(field_of "$1" port)
  creds_of "$1"
  url=$(cmd_url "$1")
  # The terminal runs a launcher script in a private directory that deletes itself on start:
  # the password is exported there, never part of a command line.
  local dir script
  dir="$HOME_DIR/run"
  mkdir -p "$dir"
  chmod 700 "$dir"
  script=$(mktemp "$dir/client-$1.XXXXXX")
  local redis_user=""
  [[ $USER_ != default ]] && redis_user="--user $(printf '%q' "$USER_")"
  {
    echo 'rm -f -- "$0"'
    printf 'export PGPASSWORD=%q MYSQL_PWD=%q REDISCLI_AUTH=%q OMADBNGIN_URL=%q\n' "$PASS_" "$PASS_" "$PASS_" "$url"
    [[ -n $PASS_ ]] || echo 'unset MYSQL_PWD REDISCLI_AUTH'
    echo 'sleep 0.5' # a moment for a just-started server
    if [[ $MODE == native ]]; then
      local base
      base="$ENGINES_DIR/$engine/$(field_of "$1" exact)"
      [[ -d $base/compat ]] && printf 'export LD_LIBRARY_PATH=%q\n' "$base/compat"
      case $engine in
      postgresql) printf 'exec %q -h 127.0.0.1 -p %q -U %q -d postgres "$@"\n' "$base/bin/psql" "$port" "$USER_" ;;
      mysql | mariadb) printf 'exec %q -h127.0.0.1 -P%q -u%q "$@"\n' "$base/bin/$engine" "$port" "$USER_" ;;
      redis | valkey) printf 'exec %q -p %q %s --no-auth-warning "$@"\n' "$base/bin/$engine-cli" "$port" "$redis_user" ;;
      mongodb) printf 'exec %q --nodb --quiet --eval %q --shell "$@"\n' "$base/bin/mongosh" 'db = connect(process.env.OMADBNGIN_URL)' ;;
      esac
    else
      local c inner_url
      c=$(container "$1")
      inner_url=${url/127.0.0.1:$port/127.0.0.1:27017}
      printf 'export OMADBNGIN_URL=%q\n' "$inner_url"
      echo 't=-i; [ -t 0 ] && t=-it'
      case $engine in
      postgresql) printf 'exec docker exec $t -e PGPASSWORD %q psql -U %q -d postgres "$@"\n' "$c" "$USER_" ;;
      mysql | mariadb) printf 'exec docker exec $t ${MYSQL_PWD+-e MYSQL_PWD} %q %q -u%q "$@"\n' "$c" "$engine" "$USER_" ;;
      redis | valkey) printf 'exec docker exec $t ${REDISCLI_AUTH+-e REDISCLI_AUTH} %q %q %s --no-auth-warning "$@"\n' "$c" "$engine-cli" "$redis_user" ;;
      mongodb) printf 'exec docker exec $t -e OMADBNGIN_URL %q mongosh --nodb --quiet --eval %q --shell "$@"\n' "$c" 'db = connect(process.env.OMADBNGIN_URL)' ;;
      esac
    fi
  } >"$script"
  if [[ $MODE == native ]]; then
    systemctl --user is-active --quiet "$(unit "$1")" || systemctl --user start "$(unit "$1")"
  else
    [[ $(docker inspect -f '{{.State.Running}}' "$(container "$1")") == true ]] || docker start "$(container "$1")" >/dev/null
  fi
  omarchy launch tui --app-id="omadbngin-$1" bash "$script"
}

cmd_logs() {
  require_managed "${1:-}"
  if [[ $MODE == native ]]; then
    omarchy launch tui --app-id="omadbngin-logs" journalctl --user -u "$(unit "$1")" -f -n 200 -o cat
  else
    omarchy launch tui --app-id="omadbngin-logs" docker logs -f --tail 200 "$(container "$1")"
  fi
}

# ---- backup, restore, port, health (1.5.0) -----------------------------------

engine_base() { echo "$ENGINES_DIR/$(field_of "$1" engine)/$(field_of "$1" exact)"; }

# backup <name> [file]: a dump of every database on the server (Redis/Valkey: an RDB snapshot)
cmd_backup() {
  local name=${1:-} file=${2:-} engine port base c tmp ext
  require_managed "$name"
  engine=$(kind_of "$(field_of "$name" engine)")
  port=$(field_of "$name" port)
  creds_of "$name"
  [[ $engine == mongodb ]] && fail "MongoDB backups: open the server in OmaTablePlus and use Database ▾ → Back up"
  ext=sql
  [[ $engine == redis || $engine == valkey ]] && ext=rdb
  [[ -n $file ]] || file="$BACKUP_DIR/$name-$(date +%Y%m%d-%H%M%S).$ext"
  [[ -d $(dirname "$file") ]] || mkdir -p "$(dirname "$file")"
  [[ -e $file ]] && fail "$file already exists"
  tmp="$file.part-$$"
  umask 077
  c=$(container "$name")
  if [[ $MODE == native ]]; then
    base=$(engine_base "$name")
    # MySQL's clients need the engine's compat libraries (libncurses) too
    if [[ -d $base/compat ]]; then export LD_LIBRARY_PATH=$base/compat; fi
    case $engine in
    postgresql) PGPASSWORD="$PASS_" "$base/bin/pg_dumpall" -h 127.0.0.1 -p "$port" -U "$USER_" --no-password -f "$tmp" ;;
    mysql) MYSQL_PWD="$PASS_" "$base/bin/mysqldump" -h127.0.0.1 -P"$port" -u"$USER_" --all-databases --routines --events --triggers --single-transaction >"$tmp" ;;
    mariadb) MYSQL_PWD="$PASS_" "$base/bin/mariadb-dump" -h127.0.0.1 -P"$port" -u"$USER_" --skip-ssl --all-databases --routines --events --triggers --single-transaction >"$tmp" ;;
    redis | valkey) REDISCLI_AUTH=$PASS_ "$base/bin/$engine-cli" -p "$port" ${PASS_:+--user "$USER_"} --no-auth-warning --rdb "$tmp" >/dev/null 2>&1 ;;
    esac
  else
    case $engine in
    postgresql) PGPASSWORD=$PASS_ docker exec -e PGPASSWORD "$c" pg_dumpall -U "$USER_" >"$tmp" ;;
    mysql) MYSQL_PWD=$PASS_ docker exec -e MYSQL_PWD "$c" mysqldump -u"$USER_" --all-databases --routines --events --triggers --single-transaction >"$tmp" ;;
    mariadb) MYSQL_PWD=$PASS_ docker exec -e MYSQL_PWD "$c" mariadb-dump -u"$USER_" --all-databases --routines --events --triggers --single-transaction >"$tmp" ;;
    redis | valkey)
      REDISCLI_AUTH=$PASS_ docker exec -e REDISCLI_AUTH "$c" "$engine-cli" ${PASS_:+--user "$USER_"} --no-auth-warning --rdb /tmp/omadbngin-backup.rdb >/dev/null 2>&1 &&
        docker cp "$c:/tmp/omadbngin-backup.rdb" "$tmp" >/dev/null && docker exec "$c" rm -f /tmp/omadbngin-backup.rdb ;;
    esac
  fi || { rm -f "$tmp"; fail "backup of $name failed"; }
  [[ -s $tmp ]] || { rm -f "$tmp"; fail "backup of $name is empty"; }
  chmod 600 "$tmp" # docker cp keeps the mode from inside the container
  mv "$tmp" "$file"
  echo "$file"
}

# restore <name> <file>: SQL runs against the server; an RDB replaces the Redis/Valkey data
cmd_restore() {
  local name=${1:-} file=${2:-} engine port base c dir
  require_managed "$name"
  [[ -f $file ]] || fail "no file at $file"
  engine=$(kind_of "$(field_of "$name" engine)")
  port=$(field_of "$name" port)
  creds_of "$name"
  c=$(container "$name")
  case $engine in
  mongodb) fail "MongoDB restores: open the server in OmaTablePlus and use Database ▾ → Restore" ;;
  redis | valkey)
    [[ $(head -c 5 "$file") == REDIS ]] || fail "$file is not an RDB snapshot"
    if [[ $MODE == native ]]; then
      dir=$(server_dir "$name")/data
      systemctl --user stop "$(unit "$name")"
      install -m 600 "$file" "$dir/dump.rdb"
      # With its append-only log on, the server would ignore the snapshot: start once with the
      # log off so it loads the snapshot, then turn the log back on (it is rebuilt from the data).
      local conf cli aof=""
      conf=$(server_dir "$name")/$engine.conf
      cli=("$(engine_base "$name")/bin/$engine-cli" -p "$port")
      [[ -n $PASS_ ]] && { cli+=(--user "$USER_" --no-auth-warning); export REDISCLI_AUTH=$PASS_; }
      grep -q '^appendonly yes' "$conf" && aof=1
      rm -rf "$dir/appendonlydir" "$dir"/appendonly*.aof
      [[ -n $aof ]] && sed -i 's/^appendonly yes/appendonly no/' "$conf"
      systemctl --user start "$(unit "$name")"
      if [[ -n $aof ]]; then
        for _ in $(seq 50); do "${cli[@]}" ping >/dev/null 2>&1 && break; sleep 0.2; done
        sed -i 's/^appendonly no/appendonly yes/' "$conf"
        "${cli[@]}" config set appendonly yes >/dev/null || fail "restored, but turning the append-only log back on failed"
      fi
    else
      # The container runs with the append-only log on, so it would ignore a snapshot: load it
      # in a throwaway server on the same volume with the log off, turn the log on so it is
      # rebuilt from the data, and hand the files back to the image's user.
      local image
      image=$(image_of "$c")
      docker stop "$c" >/dev/null
      docker run --rm --volumes-from "$c" -v "$file:/omadbngin-restore.rdb:ro" --entrypoint sh "$image" -c '
        set -e
        cd /data
        rm -rf appendonlydir appendonly*.aof
        cp /omadbngin-restore.rdb dump.rdb
        '"$engine"'-server --dir /data --port 0 --unixsocket /tmp/s --appendonly no --daemonize yes >/dev/null
        cli() { '"$engine"'-cli -s /tmp/s "$@"; }
        i=0; until cli ping >/dev/null 2>&1; do i=$((i + 1)); [ $i -lt 100 ] || exit 1; sleep 0.1; done
        cli config set appendonly yes >/dev/null
        i=0; until cli info persistence | grep -q "^aof_rewrite_in_progress:0" && cli info persistence | grep -q "^aof_rewrite_scheduled:0" &&
          cli info persistence | grep -q "^aof_enabled:1"; do i=$((i + 1)); [ $i -lt 300 ] || exit 1; sleep 0.1; done
        cli shutdown >/dev/null 2>&1 || true
        while [ -e /tmp/s ]; do sleep 0.1; done
        chown -R "$(stat -c %u:%g /data)" /data' || { docker start "$c" >/dev/null; fail "restore into $name failed"; }
      docker start "$c" >/dev/null
    fi
    return ;;
  esac
  if [[ $MODE == native ]]; then
    base=$(engine_base "$name")
    # MySQL's clients need the engine's compat libraries (libncurses) too
    if [[ -d $base/compat ]]; then export LD_LIBRARY_PATH=$base/compat; fi
    case $engine in
    postgresql) PGPASSWORD="$PASS_" "$base/bin/psql" -X -q -h 127.0.0.1 -p "$port" -U "$USER_" -d postgres -f "$file" 2>&1 >/dev/null | grep -v 'already exists' >&2; return "${PIPESTATUS[0]}" ;;
    mysql) MYSQL_PWD="$PASS_" "$base/bin/mysql" -h127.0.0.1 -P"$port" -u"$USER_" <"$file" ;;
    mariadb) MYSQL_PWD="$PASS_" "$base/bin/mariadb" -h127.0.0.1 -P"$port" -u"$USER_" --skip-ssl <"$file" ;;
    esac
  else
    case $engine in
    postgresql) PGPASSWORD=$PASS_ docker exec -i -e PGPASSWORD "$c" psql -X -q -U "$USER_" -d postgres <"$file" 2>&1 >/dev/null | grep -v 'already exists' >&2; return "${PIPESTATUS[0]}" ;;
    mysql | mariadb) MYSQL_PWD=$PASS_ docker exec -i -e MYSQL_PWD "$c" "$engine" -u"$USER_" <"$file" ;;
    esac
  fi || fail "restore into $name failed"
}

# backups <name>: JSON list of this server's backups in the backup folder, newest first
cmd_backups() {
  local name=${1:-}
  [[ -n $name ]] || fail "missing server name"
  find "$BACKUP_DIR" -maxdepth 1 -type f \( -name "$name-*.sql" -o -name "$name-*.rdb" \) -printf '%T@\t%s\t%p\n' 2>/dev/null |
    sort -rn | head -20 | jq -Rsc 'split("\n") | map(select(length > 0) | split("\t") | {path: .[2], bytes: (.[1] | tonumber), time: (.[0] | tonumber | floor)})'
}

# set-port <name> <new port>: move a server to another port (it restarts if it was running)
cmd_set_port() {
  local name=${1:-} new=${2:-} engine dir base exact running auth="" image inner data env cmd
  require_managed "$name"
  [[ $new =~ ^[0-9]+$ ]] && ((new >= 1024 && new <= 65535)) || fail "port must be 1024–65535"
  [[ $new == "$(field_of "$name" port)" ]] && return
  port_taken "$new" && fail "port $new is already in use"
  engine=$(field_of "$name" engine)
  if [[ $MODE == native ]]; then
    dir=$(server_dir "$name")
    exact=$(field_of "$name" exact)
    base=$(engine_base "$name")
    running=$(systemctl --user is-active "$(unit "$name")" 2>/dev/null || true)
    [[ $engine == mongodb && -n $(field_of "$name" password) && $(field_of "$name" password) != null ]] && auth=auth
    # the new start command first, so a failure leaves every file as it was
    local start
    start=$(with_compat "$base" "$(native_exec "$engine" "$base" "$dir" "$new" $auth)")
    [[ -n $start ]] || fail "could not build the start command for $name"
    jq --argjson p "$new" '.port = $p' "$dir/server.json" >"$dir/server.json.new" && mv "$dir/server.json.new" "$dir/server.json"
    chmod 600 "$dir/server.json"
    [[ -f $dir/$engine.conf ]] && sed -i "s/^port .*/port $new/" "$dir/$engine.conf"
    write_unit "$name" "$engine" "$exact" "$start"
    [[ $running == active || $running == failed ]] && systemctl --user restart "$(unit "$name")"
    return 0
  else
    docker_recreate "$name" "$new"
  fi
}

# Make a managed container again on the same volume (ports are fixed at creation), keeping
# its settings and running state. Redis/Valkey get their auth from the volume's config file.
docker_recreate() {
  local name=$1 new=$2 engine image inner data env cmd running c info
  engine=$(field_of "$name" engine)
  c=$(container "$name")
  info=$(docker inspect "$c")
  image=$(image_of "$c") || fail "cannot read the image of $c"
  inner=$(jq -r '.[0].HostConfig.PortBindings | keys[0] | split("/")[0]' <<<"$info")
  data=$(jq -r --arg v "$c" '.[0].Mounts[] | select(.Name == $v) | .Destination' <<<"$info")
  mapfile -t env < <(jq -r '.[0].Config.Env[] | select(test("^(POSTGRES|MYSQL|MARIADB|MONGO_INITDB)_")) | "-e", .' <<<"$info")
  mapfile -t cmd < <(jq -r '.[0].Config.Cmd // [] | .[]' <<<"$info")
  running=$(jq -r '.[0].State.Running' <<<"$info")
  local auto=off user pass
  [[ $(jq -r '.[0].HostConfig.RestartPolicy.Name' <<<"$info") == unless-stopped ]] && auto=on
  user=$(field_of "$name" user)
  pass=$(field_of "$name" password)
  docker rm -f "$c" >/dev/null
  if [[ $engine == redis || $engine == valkey ]]; then
    redis_volume_conf "$name" "$image" "$user" "$pass"
    cmd=("$engine-server" /data/omadbngin.conf --appendonly yes)
  fi
  docker_run "$name" "$engine" "$(field_of_label_version "$info")" "$new" "$auto" "$user" "$pass" "$image" "$inner" "$data" "${#env[@]}" "${env[@]}" "${cmd[@]}"
  [[ $running == true ]] || docker stop "$c" >/dev/null
}

# Redis/Valkey containers made before 1.5.1 have their password in the container command line,
# which every local account sees when it runs: make each of them again once, the same as a
# port change does. The marker is written only after a full pass with Docker up.
upgrade_redis_cmdline() {
  local marker="$HOME_DIR/.redis-cmdline-upgraded" n MODE=docker
  [[ -e $marker ]] && return 0
  [[ $(docker_status) == running ]] || return 0
  for n in $(docker ps -a --filter "label=$LABEL" --format '{{.Label "omadbngin.engine"}} {{.Label "omadbngin.name"}}' |
    awk '$1 == "redis" || $1 == "valkey" { print $2 }'); do
    if docker inspect -f '{{json .Config.Cmd}}' "$(container "$n")" | grep -qE '"--(requirepass|user)"'; then
      echo "Moving the password of $n out of its container's command line…" >&2
      docker_recreate "$n" "$(field_of "$n" port)" || return 0
    fi
  done
  mkdir -p "$HOME_DIR" && : >"$marker"
}

field_of_label_version() { jq -r '.[0].Config.Labels["omadbngin.version"]' <<<"$1"; }

case "${1:-}" in
state | create | start | stop | restart | remove | autostart | url | copy | conn | client | logs | port | install | backup | restore | set-port) migrate_legacy; upgrade_redis_cmdline ;;
esac

case "${1:-}" in
state) [[ ${2:-} == --full ]] && FULL=1; cmd_state ;;
sizes) cmd_sizes ;;
stack) shift; cmd_stack "$@" ;;
conn) cmd_conn "${2:-}" "${3:-url}" ;;
tail) cmd_tail "${2:-}" ;;
bind) cmd_bind ;;
setup) cmd_setup ;;
unbind) cmd_unbind ;;
create) shift; cmd_create "$@" ;;
start | stop | restart) cmd_power "$1" "${2:-}" ;;
remove) shift; cmd_remove "$@" ;;
autostart) shift; cmd_autostart "$@" ;;
url) cmd_url "${2:-}" ;;
copy) out=$(cmd_conn "${2:-}" "${3:-url}") && printf '%s' "$out" | wl-copy ;;
client) cmd_client "${2:-}" ;;
logs) cmd_logs "${2:-}" ;;
backup) shift; cmd_backup "$@" ;;
restore) shift; cmd_restore "$@" ;;
backups) cmd_backups "${2:-}" ;;
set-port) shift; cmd_set_port "$@" ;;
port) next_port "${2:-}" "${3:-}" ;;
install)
  [[ " $(engine_field "${2:-}" versions) " == *" ${3:-} "* ]] || fail "usage: install <engine> <version>"
  [[ $(engine_field "$2" only) == docker ]] && fail "$(engine_field "$2" title) runs in Docker only"
  ensure_engine "$2" "$3"
  ;;
*) sed -n '3,47p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
